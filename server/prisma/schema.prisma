generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COUNTY_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum TokenType {
  ACTIVATION
  PASSWORD_RESET
}

enum AttendanceStatus {
  ACTIVE
  FLAGGED_FOR_REMOVAL
  RETIRED
}

enum EventLocationType {
  PHYSICAL
  VIRTUAL
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?
  role         Role
  county       String?
  status       UserStatus @default(PENDING)

  createdById  String?
  createdBy    User?      @relation("CreatedAdmins", fields: [createdById], references: [id])
  createdAdmins User[]    @relation("CreatedAdmins")

  createdAt    DateTime   @default(now())
  disabledAt   DateTime?
  lastLoginAt  DateTime?

  tokens       AuthToken[]
  sessions     Session[]
  events       Event[]     @relation("EventOwner")
  auditEntries AuditLog[]  @relation("Actor")

  @@index([role, status])
  @@index([county])
}

model AuthToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       TokenType
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, type])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
}

model Event {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  county      String

  // Plain DateTime, same as every other instant column in this schema
  // (createdAt, expiresAt, ...) -- always handled as a JS Date through
  // Prisma, never touched with raw SQL date arithmetic, so there's no need
  // for @db.Timestamptz here. `timezone` is what lets a viewer-independent
  // "this event's own local time" be reconstructed for display (see
  // lib/timezone.js) -- startAt/endAt themselves are just UTC instants.
  startAt  DateTime
  endAt    DateTime
  timezone String

  locationType EventLocationType @default(PHYSICAL)
  // Exactly one of these is populated, based on locationType -- enforced
  // by request validation (requireEventFields in admin.js), not a DB
  // constraint, matching how this schema already validates shape at the
  // route layer rather than with CHECK constraints elsewhere.
  address     String?
  meetingLink String?

  // Nullable so the owning admin can be hard-deleted (superadminRouter DELETE
  // /admins/:id) without being blocked forever. Deliberately not cascaded:
  // a deleted owner's events go ownerless rather than gone -- the public
  // attendance flow (public.js) looks events up by slug, never by owner, so
  // signing continues to work. What's lost is admin-side visibility: the
  // per-admin event list (admin.js) filters strictly by ownerId, so an
  // ownerless event stops appearing there for anyone.
  ownerId   String?
  owner     User?     @relation("EventOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  attendance Attendance[]

  @@index([county])
  @@index([ownerId])
}

model Attendance {
  id              String   @id @default(uuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  clientId        String
  name            String
  organization    String?
  email           String?
  emailNormalized String?
  phone           String
  phoneNormalized String
  signature       String
  // True for rows backfilled from a legacy source (e.g. a paper/Excel sign-in
  // sheet) where no real drawn signature was ever captured -- `signature` for
  // these is a generated initials image, not an authentic attendee mark, and
  // callers that care about that distinction (admin UI, exports) key off this
  // rather than trying to infer it from the image content.
  isImportedSignature Boolean @default(false)
  createdAt       DateTime @default(now())

  // Soft-retirement lifecycle: a row is never hard-deleted, only moved
  // ACTIVE -> FLAGGED_FOR_REMOVAL -> RETIRED (or back), see the
  // /flag, /retire, /reopen routes in public.js. Who made each transition
  // and why lives in AuditLog (actor snapshot + [targetType, targetId]
  // index already exist there) rather than being duplicated here -- this
  // row only tracks its own current state, not its history.
  status       AttendanceStatus @default(ACTIVE)
  statusReason String?
  statusAt     DateTime?

  // Lets an admin send a one-time link to an attendee whose row is missing
  // a signature (see /api/signature-requests/:token) so they can add it
  // themselves after the fact, without needing the original submitting
  // device. Hash-only, same pattern as AuthToken -- the raw token only ever
  // exists in the link handed to the admin.
  signatureRequestTokenHash String?   @unique
  signatureRequestExpiresAt DateTime?

  @@unique([eventId, clientId])
  @@unique([eventId, phoneNormalized])
  @@unique([eventId, emailNormalized])
  @@index([eventId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)

  // Snapshot of the actor at write time. actorId goes to NULL if the actor
  // is later hard-deleted (see superadminRouter DELETE /admins/:id) -- these
  // columns are what keep an old entry readable ("who did this") after that,
  // since the join to User is gone.
  actorEmail  String?
  actorRole   Role?
  actorCounty String?

  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  // Tamper-evident chain: hash covers this entry's own fields plus
  // prevHash, which is the hash of whatever entry was most recently
  // written when this one was created (see writeAudit in lib/audit.js).
  // Altering or deleting an old entry breaks every hash after it, so the
  // break is detectable by recomputation rather than trusted by default.
  // Entries written before this column existed are left null -- the chain
  // starts clean from the first entry written after this migration,
  // not backfilled.
  prevHash String?
  hash     String?

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}
